# =============================================================================
# Kia-Agent — Railway variables
# Paste into Railway → Project → Variables (or `railway variables set`).
#
# Postgres and Redis plugins inject DATABASE_URL and REDIS_URL automatically.
# Do NOT commit real secrets. Generate WEB_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- Core ---
APP_ENV=production
BOOTSTRAP_MODE=full
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true
LOG_TO_DB=true
PORT=8080

TENANT_ID=your-tenant
TENANT_NAME_EN=Your Company
TENANT_NAME_AR=شركتك
SUPPORT_CONTACT=ops@example.com
BRAND_PRIMARY_COLOR=#00f0ff

# --- Data (Railway plugins) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# --- Object storage (Cloudflare R2 / S3-compatible) ---
R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kia-agent
R2_PREFIX=tenants/your-tenant
R2_SIGNED_URL_TTL=3600
ARCHIVE_FINAL_OUTPUTS=true
PG_DUMP_RETENTION_DAYS=30
HOT_DATA_DAYS=90
BACKUP_ENABLED=true
BACKUP_HOUR=3

# --- Admin ---
ADMIN_USERNAME=kia
ADMIN_BOOTSTRAP_PASSWORD=
WEB_SECRET=
WEB_PORT=8080
COOKIE_SECURE=true
TOTP_ENABLED=false

# --- LLM ---
LLM_MODE=direct
DIRECT_BASE_URL=https://openrouter.ai/api/v1
DIRECT_API_KEY=
DIRECT_MODEL=anthropic/claude-sonnet
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_TEMPERATURE=0.3
ROUTER_BASE_URL=http://9router:20128/v1
ROUTER_ACCESS_KEY=
ROUTER_TIMEOUT=120
ROUTER_FALLBACK_TO_DIRECT=true
HERMES_BASE_URL=
HERMES_SERVICE_TOKEN=
HERMES_TIMEOUT=180

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# --- Optional channels ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

EMAIL_ENABLED=false
EMAIL_INBOUND_PROVIDER=imap
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=60
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
RESEND_WEBHOOK_SECRET=

INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
DEFAULT_REMINDER_MINUTES=60

# --- Policy / HITL ---
CURRENCY=EUR
TAX_RATE=0.21
QUOTE_VALID_DAYS=7
NUMERAL_STYLE=western
RATE_LIMIT_PER_MINUTE=60
HITL_TIMEOUT_SECONDS=600
HITL_FALLBACK=silent
HITL_PING_TELEGRAM=true

# --- Memory / fleet ---
MEMORY_ENABLED=true
MEMORY_EXTRACT_EVERY=4
MEMORY_BUDGET_CHARS=1200
MEMORY_PERSONA_THRESHOLD=3
FLEET_ENABLED=true
FLEET_MAX_TEAM_SIZE=6
FLEET_TEAM_TIMEOUT=180

# --- 10k-member notes ---
# One Railway web service (this Dockerfile) handles ~10k registered members
# at 12% hourly activity (~0.7 inbound msg/s). Add a second service with
# start command:  kia worker --group pipeline --concurrency 8
# when inbound exceeds ~5 msg/s or HITL staffing is the limit, not CPU.
