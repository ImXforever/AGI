# ============================================================
#  Zenovix Agent 1.6.0  ×  Zenovix (zenovix.ae)  —  Twilio edition
#  Railway → service "AGI" → Variables → Raw Editor → paste everything
#  Lines starting with # are comments (Railway ignores them). No quotes.
#  Search for PASTE_ — those are the only values you must fill in.
# ============================================================

# ---------- A. Core (app refuses to start without these) ----------
APP_ENV=production
TENANT_ID=zenovix
TENANT_NAME_EN=Zenovix — AI & Digital Technology
TENANT_NAME_AR=زينوفكس للذكاء الاصطناعي والتقنية الرقمية
SUPPORT_CONTACT=studio@zenovix.com
# USD is the platform's primary currency (prices, quotes, reports)
CURRENCY=USD

# Telegram (bot token from @BotFather, your numeric id from @userinfobot)
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN
TELEGRAM_ADMIN_IDS=PASTE_YOUR_TELEGRAM_NUMERIC_ID
TELEGRAM_WEBHOOK_SECRET=PASTE_16PLUS_CHAR_RANDOM_SECRET

# Admin panel login  (https://agi-production-1f9f.up.railway.app/admin)
ADMIN_USERNAME=zenovix-admin
ADMIN_BOOTSTRAP_PASSWORD=PASTE_STRONG_ADMIN_PASSWORD
WEB_SECRET=PASTE_16PLUS_CHAR_RANDOM_SECRET
COOKIE_SECURE=true

# Database + Redis (Railway reference variables – copy exactly)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# File storage = your Railway Bucket (service name: coordinated-toolchest)
# If any of these 4 shows empty/red after saving, open the Bucket →
# "Credentials" tab and paste the 4 values by hand instead.
R2_ENDPOINT=${{coordinated-toolchest.ENDPOINT}}
R2_ACCESS_KEY_ID=${{coordinated-toolchest.ACCESS_KEY_ID}}
R2_SECRET_ACCESS_KEY=${{coordinated-toolchest.SECRET_ACCESS_KEY}}
R2_BUCKET=${{coordinated-toolchest.BUCKET}}
R2_SIGNED_URL_TTL=3600

# ---------- B. AI model (direct mode – the only mode that works on this canvas) ----------
LLM_MODE=direct
DIRECT_BASE_URL=https://api.openai.com/v1
DIRECT_API_KEY=PASTE_YOUR_OPENAI_KEY
DIRECT_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STANDARD=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Alternative (OpenRouter – one key, many models):
#   DIRECT_BASE_URL=https://openrouter.ai/api/v1
#   DIRECT_API_KEY=sk-or-...
#   DIRECT_MODEL=openai/gpt-4o-mini

# ---------- C. Zenovix identity & business rules ----------
BRAND_LOGO_URL=https://agi-production-1f9f.up.railway.app/web/assets/brand/zenovix-logo-white.png
BRAND_PRIMARY_COLOR=#8A3FE6
TENANT_TIMEZONE=Asia/Dubai
BUSINESS_HOURS=09:00-18:00
TAX_RATE=0.05
QUOTE_VALID_DAYS=7
LEAD_SCORING_ENABLED=true
LEAD_ALERT_ENABLED=true
NUMERAL_STYLE=western
REPLY_LANGUAGE_POLICY=english-first
RATE_LIMIT_PER_MINUTE=30

# ---------- D. Human approval (HITL) ----------
HITL_TIMEOUT_SECONDS=900
HITL_FALLBACK=silent
HITL_PING_TELEGRAM=true

# ---------- E. Memory, fleet, ops ----------
MEMORY_ENABLED=true
MEMORY_PROVIDER=postgresql
MEMORY_EXTRACT_EVERY=6
MEMORY_BUDGET_CHARS=800
MEMORY_PERSONA_THRESHOLD=4
FLEET_ENABLED=false
FLEET_MAX_TEAM_SIZE=8
FLEET_TEAM_TIMEOUT=300
BOOTSTRAP_MODE=full
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true
LOG_TO_DB=true
SCHEMA_GUARD_MODE=warn
BACKUP_ENABLED=true
BACKUP_HOUR=23
PG_DUMP_RETENTION_DAYS=30
HOT_DATA_DAYS=90
ARCHIVE_FINAL_OUTPUTS=true
TOTP_ENABLED=false

# ---------- F. Twilio — WhatsApp (sandbox, 98 free messages) ----------
# Twilio Console home page → "Account Info" box at the bottom
TWILIO_ACCOUNT_SID=PASTE_ACCOUNT_SID_STARTS_WITH_AC
TWILIO_AUTH_TOKEN=PASTE_AUTH_TOKEN
# Sandbox number, shown on: Messaging → Try it out → Send a WhatsApp message
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_BASE_URL=https://api.twilio.com/2010-04-01
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=twilio
# In the Sandbox settings, field "When a message comes in" (POST):
#   https://agi-production-1f9f.up.railway.app/wa/webhook

# ---------- G. Twilio SendGrid — e-mail OUT (3000 free) + IMAP — e-mail IN ----------
EMAIL_ENABLED=true
EMAIL_PROVIDER=sendgrid
# The exact address you verified in SendGrid → Sender Authentication → Single Sender
EMAIL_FROM=PASTE_THE_ADDRESS_YOU_VERIFIED_IN_SENDGRID
EMAIL_REPLY_TO=studio@zenovix.com
# SendGrid → Settings → API Keys → Create (Full Access) → starts with "SG."
SENDGRID_API_KEY=PASTE_SENDGRID_KEY_STARTS_WITH_SG.
# Inbound: the bot reads the SAME mailbox over IMAP (Gmail: enable IMAP + App Password)
EMAIL_INBOUND_PROVIDER=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=PASTE_THE_SAME_MAILBOX_ADDRESS
IMAP_PASSWORD=PASTE_16_CHAR_GOOGLE_APP_PASSWORD
IMAP_POLL_SECONDS=60

# ---------- H. Optional channels (enable when Zenovix connects the accounts) ----------
INSTAGRAM_ENABLED=false
TWITTER_ENABLED=false
CALENDAR_ENABLED=false
